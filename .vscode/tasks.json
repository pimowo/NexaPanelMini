{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlatformIO Build NexaPanelMini",
			"type": "shell",
			"command": "C:\\Users\\piotrek\\.platformio\\penv\\Scripts\\pio.exe",
			"args": [
				"run"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"label": "PlatformIO Upload NexaPanelMini",
			"type": "shell",
			"command": "C:\\Users\\piotrek\\.platformio\\penv\\Scripts\\pio.exe",
			"args": [
				"run",
				"--target",
				"upload",
				"--upload-port",
				"COM5"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Git Final Precheck",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"git status --short --branch; Write-Host '---'; git diff --check; Write-Host '---'; git ls-files include/secrets.h include/secrets.example.h include/config.h include/pins.h include/app_config.h"
			]
		},
		{
			"label": "Git Commit Cleanup",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-am",
				"Remove temporary Git helper tasks from VS Code tasks"
			]
		}
	]
}